# Auto detect text files and normalize line endings to LF
* text=auto

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Documentation
*.md text eol=lf
LICENSE text eol=lf
INSTALL.md text eol=lf
CHANGELOG.md text eol=lf

# Python
*.py text eol=lf

# Ignore files
.gitignore text eol=lf
.gitattributes text eol=lf
